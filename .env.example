# Copia este archivo a ".env" (en la raíz del repositorio) y ajusta las rutas.
# Las rutas relativas se resuelven desde la raíz del repositorio.

# Carpeta con los MP4 locales. Se busca en ella el NOMBRE de archivo que figura
# en video_mapping.json (p. ej. "Pilar Barrientos Conde.mp4"), no la ruta de Colab.
MDF_VIDEOS_DIR=/ruta/a/tus/videos_originales

# Datos de la demostración (por defecto datos/demo).
# MDF_DATOS_DIR=datos/demo
# MDF_PLAYLIST_ARCHIVO=playlist.json
# MDF_MAPA_VIDEOS_ARCHIVO=video_mapping.json
# MDF_TEMAS_ARCHIVO=temas_preparados.json
# MDF_ENTREVISTAS_ARCHIVO=entrevistas.json

# Transcripciones con marcas temporales (por defecto datos/demo/transcripciones).
# Se busca <interview_id>.json, <interview_id>_transcripcion_corregida.json o un
# nombre que sea prefijo del identificador (si es único).
# MDF_TRANSCRIPCIONES_DIR=datos/demo/transcripciones
# MDF_TRANSCRIPCIONES_EXTRA={"MariaJoseRoa": "roa.json"}

# La lista exportada NO guarda el texto de la consulta ni la fecha. Si los
# conoces, se mostrarán en el aviso de demostración.
# MDF_DEMO_CONSULTA=
# MDF_DEMO_FECHA=2026-10-22T19:01:50Z

# Excepciones: un archivo distinto para una entrevista (JSON en una línea).
# MDF_VIDEOS_EXTRA={"Pilar_Barrientos_Conde_02_2": "pilar_v2.mp4"}

# --- Buscador en directo -------------------------------------------------------
# Requiere:  pip install -e ".[busqueda]"
# "auto" lo activa si están los archivos del índice y las dependencias; "off" lo desactiva.
# MDF_BUSCADOR=auto
# Modelo que codifica la consulta. DEBE ser el mismo con el que se creó el índice.
# Puede ser una ruta a una copia local del modelo (para trabajar sin conexión).
# MDF_MODELO_CONSULTAS=BAAI/bge-m3
# "" = automático (cuda si hay GPU, si no cpu). Para forzar:  cpu  |  cuda
# MDF_MODELO_DISPOSITIVO=
# Cargar el modelo al arrancar en vez de en la primera consulta.
# MDF_BUSCADOR_PRECARGA=false
# Carpeta del índice (por defecto datos/demo/indice) y archivo de historias.
# MDF_INDICE_DIR=datos/demo/indice
# MDF_HISTORIAS_ARCHIVO=historias_preparadas.json
